# Copie este arquivo para ".env" e preencha os valores reais.
# Nenhuma dessas chaves deve ir para o repositório git.

# Mesmo projeto Supabase do BatataFlix Web — copie os mesmos valores do
# ".env.local" do app web (Project Settings > API, no painel do Supabase).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# URL do BatataFlix Web publicado (Vercel) — usada só para as buscas que
# precisam das chaves do TMDb/OMDb (nunca ficam dentro do app mobile).
EXPO_PUBLIC_API_BASE_URL=https://batata-flix-web.vercel.app
